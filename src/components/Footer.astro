---
import { withBase } from '../lib/paths';
import { contactPage } from '../lib/site-pages';

const noteLines = (contactPage.note ?? '').split('\n').filter(Boolean);
---

<footer class="footer" id="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="brand" href={withBase('/')}>
        <span class="cat-logo"><i></i></span>
        <span>NOTES</span>
      </a>
      <p>個人文章、圖片與短片演示，慢慢累積成一座小資料庫。</p>
    </div>
    <nav class="footer-links">
      <a href={withBase('/about/')}>關於我</a>
      <a href={withBase('/faq/')}>常見問題</a>
      <a href={withBase('/contact/')}>聯絡方式</a>
    </nav>
    <div class="footer-contact">
      聯絡信箱<br /><br />
      <a href={`mailto:${contactPage.email}`}>{contactPage.email}</a>
      {noteLines.map((line) => (
        <>
          <br />
          {line}
        </>
      ))}
    </div>
  </div>
  <div class="copyright">© {new Date().getFullYear()} NOTES. 個人部落格。</div>
</footer>
