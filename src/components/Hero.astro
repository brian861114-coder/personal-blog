---
interface Props {
  eyebrow?: string;
  title?: string;
}

const { eyebrow = 'ニュース', title = '個人部落格' } = Astro.props;
---

<section class="hero">
  <div class="hero-title">
    <div class="jp">{eyebrow}</div>
    <h1>{title}</h1>
  </div>
  <div class="hero-dots"><i></i><i></i></div>
</section>
