---
import { getCollection, render } from 'astro:content';
import SitePage from '../components/SitePage.astro';
import Break from '../components/Break.astro';
import PostImg from '../components/PostImg.astro';

const pages = await getCollection('about');
const about = pages[0];
if (!about) {
  throw new Error('缺少關於我內容：請在後台「關於我」儲存一次。');
}

const { Content } = await render(about);
---

<SitePage
  title={about.data.title}
  description={about.data.description}
  kicker="關於"
  heading={about.data.title}
  current="about"
>
  <Content components={{ Break, img: PostImg }} />
</SitePage>
